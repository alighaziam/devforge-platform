{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devforge.example/schemas/plugin-manifest/1.0.0",
  "title": "DevForge Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "plugin", "capabilities", "compatibility", "permissions", "entrypoints"],
  "properties": {
    "manifestVersion": { "const": "1.0.0" },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "publisher", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$" },
        "name": { "type": "string" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$" },
        "publisher": { "type": "string" },
        "kind": { "type": "string", "enum": ["generator", "technology-provider", "integration", "validator", "template-pack"] },
        "description": { "type": "string" },
        "license": { "type": "string" }
      }
    },
    "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platformApi", "specificationVersions"],
      "properties": {
        "platformApi": { "type": "string" },
        "specificationVersions": { "type": "array", "items": { "type": "string" } },
        "technologies": { "type": "array", "items": { "type": "string" } },
        "operatingSystems": { "type": "array", "items": { "type": "string" } }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["workspace.read", "workspace.write", "artifact.read", "artifact.write", "network.egress", "secret.read", "process.execute"] }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "command"],
      "properties": {
        "protocol": { "type": "string", "enum": ["oci", "grpc", "http", "wasm"] },
        "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "healthcheck": { "type": "string" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digest": { "type": "string" },
        "signature": { "type": "string" },
        "keyId": { "type": "string" }
      }
    }
  }
}
