# Local database credentials. Replace before starting PostgreSQL.
DATABASE_URL=jdbc:postgresql://localhost:5432/devforge
DATABASE_USERNAME=devforge
DATABASE_PASSWORD=replace-with-a-long-random-password
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1

# For a deployed environment using the optional WSO2 profile.
WSO2_ISSUER_URI=https://localhost:9443/oauth2/token
WSO2_JWKS_URI=https://localhost:9443/oauth2/jwks
